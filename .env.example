# Netlify → Site settings → Environment variables
# Required for live Spotify updates on the now-playing pill.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# One-time refresh token setup:
# 1. Create an app at https://developer.spotify.com/dashboard
# 2. Add redirect URI: http://127.0.0.1:8888/callback
# 3. Add redirect URI in Spotify dashboard: http://127.0.0.1:8888/callback
# 4. Run: python3 scripts/spotify_get_refresh_token.py
# 5. Paste refresh_token into Netlify env vars and redeploy.
